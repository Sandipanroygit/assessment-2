@@ -0,0 +1,63 @@
+import { MENSA_DAY_SCHEDULE, type MensaDayScheduleRow } from "@/data/mensaSchedule";
+
+export type JeeMainSubject = "Physics" | "Chemistry" | "Mathematics";
+
+export type JeeDailyTopic = {
+  subject: JeeMainSubject;
+  topicId: string;
+  title: string;
+  description?: string;
+  unit?: string;
+};
+
+export type JeeDailyPlan = {
+  date: string; // ISO date
+  topics: JeeDailyTopic[];
+};
+
+const SUBJECT_ORDER: JeeMainSubject[] = ["Mathematics", "Physics", "Chemistry"];
+
+const buildTopics = (row: MensaDayScheduleRow): JeeDailyTopic[] => {
+  const entries: JeeDailyTopic[] = [];
+  const subjects: Record<JeeMainSubject, string> = {
+    Mathematics: row.mathematics,
+    Physics: row.physics,
+    Chemistry: row.chemistry,
+  };
+
+  SUBJECT_ORDER.forEach((subject) => {
+    const value = subjects[subject]?.trim();
+    if (!value) return;
+    entries.push({
+      subject,
+      topicId: `${subject.toLowerCase()}-day-${row.day}`,
+      title: value,
+      unit: `Day ${row.day}`,
+    });
+  });
+
+  return entries;
+};
+
+const formatDateKey = (value: Date | string) => {
+  const date = typeof value === "string" ? new Date(value) : value;
+  return date.toISOString().split("T")[0];
+};
+
+export const getJeeDailySchedule = (startDate?: Date, days?: number): JeeDailyPlan[] => {
+  if (!MENSA_DAY_SCHEDULE.length) {
+    return [];
+  }
+
+  const startKey = startDate ? formatDateKey(startDate) : MENSA_DAY_SCHEDULE[0].date;
+  const startIndex =
+    MENSA_DAY_SCHEDULE.findIndex((row) => row.date >= startKey);
+
+  const sliceStart = startIndex >= 0 ? startIndex : 0;
+  const filtered = MENSA_DAY_SCHEDULE.slice(sliceStart, days ? sliceStart + days : undefined);
+
+  return filtered.map((row) => ({
+    date: row.date,
+    topics: buildTopics(row),
+  }));
+};
