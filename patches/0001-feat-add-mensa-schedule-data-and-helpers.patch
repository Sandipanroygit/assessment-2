new file mode 100644
index 0000000..49c924b
--- /dev/null
+++ b/parse_syllabus.py
@@ -0,0 +1,32 @@
+import fitz, re
+path='JEE.pdf'
+doc=fitz.open(path)
+text='\n'.join(page.get_text() for page in doc)
+sections=['MATHEMATICS','PHYSICS','CHEMISTRY']
+seg_text={}
+for i,sec in enumerate(sections):
+    start=text.index(sec)
+    end=text.index(sections[i+1]) if i+1<len(sections) else len(text)
+    seg_text[sec]=text[start:end].strip()
+def parse_section(seg):
+    lines=seg.splitlines()
+    topics=[]
+    for line in lines:
+        line=line.strip()
+        if not line:
+            continue
+        if line.startswith('UNIT'):
+            topics.append(line)
+            continue
+        parts=[part.strip() for part in re.split(r';|\.', line) if part.strip()]
+        for part in parts:
+            topics.append(part)
+    return topics
+parsed={}
+totals=0
+for sec in sections:
+    parsed[sec]=parse_section(seg_text[sec])
+    print(sec,len(parsed[sec]))
+    print(parsed[sec][:5])
+    totals+=len(parsed[sec])
+print('total topics',totals)
