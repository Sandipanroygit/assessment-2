+import csv, json
+from pathlib import Path
+path = Path('docs/mensa-18m-schedule.csv')
+rows = list(csv.DictReader(path.read_text(encoding='utf-8').splitlines()))
+with open('src/data/mensaSchedule.ts', 'w', encoding='utf-8') as fh:
+    fh.write('export type MensaDayScheduleRow = {\n')
+    fh.write('  day: number;\n  date: string;\n  mathematics: string;\n  physics: string;\n  chemistry: string;\n};\n\n')
+    fh.write('export const MENSA_DAY_SCHEDULE: MensaDayScheduleRow[] = ')
+    entries = []
+    for row in rows:
+        entries.append({
+            'day': int(row['Day']),
+            'date': row['Date'],
+            'mathematics': row['Mathematics'],
+            'physics': row['Physics'],
+            'chemistry': row['Chemistry'],
+        })
+    json.dump(entries, fh, ensure_ascii=False, indent=2)
+    fh.write(' as const;\n')
diff --git a/generate_schedule.py b/generate_schedule.py
new file mode 100644
index 0000000..b568810
--- /dev/null
+++ b/generate_schedule.py
@@ -0,0 +1,82 @@
+import fitz, re, csv
+from datetime import date, timedelta
+
+doc=fitz.open('JEE.pdf')
+text='\n'.join(page.get_text() for page in doc)
+subjects=['MATHEMATICS','PHYSICS','CHEMISTRY']
+seg_text={}
+for i,sub in enumerate(subjects):
+    start=text.index(sub)
+    end=text.index(subjects[i+1]) if i+1<len(subjects) else len(text)
+    seg_text[sub]=text[start:end]
+
+def _merge_segment_lines(segment: str) -> list[str]:
+    buffer = ""
+    merged = []
+    for raw in segment.splitlines():
+        line = raw.strip()
+        if not line:
+            if buffer:
+                merged.append(buffer)
+                buffer = ""
+            continue
+        if buffer and buffer[-1] not in ".;:" and line and line[0].islower():
+            buffer = f"{buffer} {line}"
+        else:
+            if buffer:
+                merged.append(buffer)
+            buffer = line
+    if buffer:
+        merged.append(buffer)
+    return merged
+
+def parse_section(seg):
+    heading_blacklist = {sub.upper() for sub in subjects}
+
+    def is_heading(text: str) -> bool:
+        stripped = text.strip()
+        upper = stripped.upper()
+        if upper in heading_blacklist:
+            return True
+        if stripped.startswith("Syllabus for"):
+            return True
+        if stripped.isupper() and not any(char.isdigit() for char in stripped) and len(stripped.split()) <= 4:
+            return True
+        return False
+
+    entries: list[str] = []
+    for chunk in _merge_segment_lines(seg):
+        if not chunk:
+            continue
+        if is_heading(chunk):
+            continue
+        for part in re.split(r";|\.\s*", chunk):
+            clean = part.strip()
+            if clean:
+                entries.append(clean.rstrip("."))
+    return entries
+
+topic_lists={}
+total=0
+for sub in subjects:
+    topic_lists[sub]=parse_section(seg_text[sub])
+    total += len(topic_lists[sub])
+
+days=547
+start=date(2026,3,17)
+rows=[]
+for i in range(days):
+    current=start+timedelta(days=i)
+    row={
+        'Day': i+1,
+        'Date': f"{current:%Y-%m-%d}",
+        'Mathematics': topic_lists['MATHEMATICS'][i % len(topic_lists['MATHEMATICS'])],
+        'Physics': topic_lists['PHYSICS'][i % len(topic_lists['PHYSICS'])],
+        'Chemistry': topic_lists['CHEMISTRY'][i % len(topic_lists['CHEMISTRY'])],
+    }
+    rows.append(row)
+with open('docs/mensa-18m-schedule.csv','w',newline='',encoding='utf-8') as fh:
+    writer=csv.DictWriter(fh, fieldnames=['Day','Date','Mathematics','Physics','Chemistry'])
+    writer.writeheader()
+    writer.writerows(rows)
+print('generated docs/mensa-18m-schedule.csv with', days, 'entries (math', len(topic_lists['MATHEMATICS']), 'physics', len(topic_lists['PHYSICS']), 'chemistry', len(topic_lists['CHEMISTRY']), 'topics)')
